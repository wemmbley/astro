{
  "name": "wiki",
  "version": "1.0.0",
  "description": "Wiki for documentations.",
  "main": "src/Bootstrap/App.tsx",
  "scripts": {
    "dev": "tsx server/serve.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "start": "NODE_ENV=production node server.js"
  },
  "keywords": [
    "wiki"
  ],
  "author": "Rustam Wemmbley Holev",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.0.3"
  }
}
